<mxfile host="app.diagrams.net">
  <diagram name="C4 Level 1 - Context">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="C4 LEVEL 1 - SYSTEM CONTEXT&#xa;BFS vs DFS Graph Search System"
          style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle"
          vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="700" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="request" value="Search Request&#xa;&#xa;Requests BFS or DFS graph search"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16"
          vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="system" value="BFS vs DFS&#xa;Graph Search System&#xa;&#xa;Searches the graph using BFS and DFS&#xa;and reports nodes expanded."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1"
          vertex="1" parent="1">
          <mxGeometry x="570" y="270" width="460" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="result" value="Search Result&#xa;&#xa;Algorithm result&#xa;Nodes expanded"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16"
          vertex="1" parent="1">
          <mxGeometry x="1250" y="330" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="pyspy" value="py-spy&#xa;Python Profiling Tool&#xa;&#xa;Observes BFS and DFS execution"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16"
          vertex="1" parent="1">
          <mxGeometry x="660" y="600" width="280" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="submits search request"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2"
          edge="1" parent="1" source="request" target="system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="returns search result"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2"
          edge="1" parent="1" source="system" target="result">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="profiles execution"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2"
          edge="1" parent="1" source="pyspy" target="system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
